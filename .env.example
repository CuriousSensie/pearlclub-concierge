# OpenAI (optional; when set it is used instead of Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server only — never expose to the client

# MapTiler
NEXT_PUBLIC_MAPTILER_KEY=

# Limits
MAX_MESSAGES_PER_SESSION=40
MAX_MESSAGES_PER_IP_PER_DAY=80   # enforced in production (or ENFORCE_DAILY_LIMITS=true)
MAX_MESSAGES_PER_DAY=1500        # whole-demo ceiling per UTC day
MAX_LOOKUPS_PER_IP_PER_DAY=60
