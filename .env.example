# OpenAI (optional; when set it is used instead of Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-nano

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Server only: never expose the service role key to the client
SUPABASE_SERVICE_ROLE_KEY=

# MapTiler
NEXT_PUBLIC_MAPTILER_KEY=

# Limits
MAX_MESSAGES_PER_SESSION=40
# Daily caps are enforced in production (or locally with ENFORCE_DAILY_LIMITS=true)
MAX_MESSAGES_PER_IP_PER_DAY=80
# Whole-demo ceiling per UTC day
MAX_MESSAGES_PER_DAY=1500
MAX_LOOKUPS_PER_IP_PER_DAY=60
MAX_WRITES_PER_IP_PER_DAY=300

# Protects /api/cron/purge (Vercel sends it as a Bearer token). 16+ random characters.
CRON_SECRET=
